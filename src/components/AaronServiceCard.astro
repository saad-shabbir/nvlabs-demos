---
import { formatDuration, type Svc } from "../data/aaron";

interface Props {
  service: Svc;
  pick?: boolean;
  home?: boolean;
}

const { service, pick = false, home = false } = Astro.props;
const name = home && service.homeName ? service.homeName : service.name;
const line = home && service.homeLine ? service.homeLine : service.line;
const duration = formatDuration(service.minutes);
const timeLabel = duration && home && service.homeTimeNote ? `${duration}, ${service.homeTimeNote}` : duration;

const icons: Record<string, string> = {
  oil: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3s6 7.2 6 12a6 6 0 0 1-12 0c0-4.8 6-12 6-12z"/></svg>',
  plug: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3v5M15 3v5M8 8h8v3a4 4 0 0 1-4 4 4 4 0 0 1-4-4V8zM12 15v6"/></svg>',
  coil: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3" width="10" height="14" rx="2"/><path d="M9 21h6M12 17v4M10 7h4M10 11h4"/></svg>',
  belt: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7" cy="14" r="3"/><circle cx="17" cy="8" r="3"/><path d="M9.2 11.8 14.8 10.2M9.5 16.2 15 17.5"/><circle cx="16" cy="17" r="2.2"/></svg>',
  battery: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="16" height="10" rx="2"/><path d="M19 10h2v4h-2M7 12h4M9 10v4"/></svg>',
  terminal: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 14c2-6 5-8 7-8s5 2 7 8"/><path d="M8 14h8v4H8zM12 6V3"/></svg>',
  brake: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2"/><path d="M12 2v3M12 19v3M4.5 6.5l2.2 2.2"/></svg>',
  shock: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8M9 3v4h6V3M8 7h8v3H8zM10 10v8M14 10v8M8 18h8M9 21h6"/></svg>',
  arm: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="16" r="3"/><circle cx="18" cy="7" r="2.5"/><path d="M8.6 14.2 16 8.6"/></svg>',
  hub: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="8"/><path d="M12 4v3M12 17v3M4 12h3M17 12h3"/></svg>',
  axle: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h18"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="12" r="3"/></svg>',
  pump: '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="6"/><path d="M12 7V4M9 4h6M12 10v6M10 13h4"/></svg>',
  radiator: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="1"/><path d="M8 5V3M12 5V3M16 5V3M8 9v6M12 9v6M16 9v6"/></svg>',
  thermo: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14V5a2 2 0 0 1 4 0v9a4 4 0 1 1-4 0z"/><path d="M12 14v3"/></svg>',
  hose: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8c4 0 4 8 8 8s4-8 8-8"/></svg>',
  gasket: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2"/><circle cx="12" cy="12" r="3"/></svg>',
  bolt: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/></svg>',
  window: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="1"/><path d="M12 3v18M4 12h16"/></svg>',
  ac: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M4.5 6.5l15 11M19.5 6.5l-15 11M12 8l-2-2M12 8l2-2M12 16l-2 2M12 16l2 2"/></svg>',
  wrench: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 6a4 4 0 0 0-5.7 4.9L3 16.2 6.8 20l5.3-5.3A4 4 0 0 0 18 8l-3 3-2-2 1-3z"/></svg>',
};

const icon = icons[service.icon] ?? icons.wrench;
const minutesAttr = service.minutes == null ? "none" : String(service.minutes);
---

{
  pick ? (
    <button
      type="button"
      class="svc"
      data-svc
      data-id={service.id}
      data-name={service.name}
      data-labor={service.labor}
      data-minutes={minutesAttr}
      data-each={service.each ?? undefined}
      aria-pressed="false"
    >
      <span class="svc-top">
        <span class="ico" set:html={icon} />
        <span class="picked-flag">Selected</span>
      </span>
      <span class="svc-name">{name}</span>
      <span class="svc-line">{line}</span>
      <span class="svc-foot">
        <span>
          <span class="plabel">Starting labor</span>
          <span class="price">${service.labor}</span>
          {service.each ? <span class="each">${service.each} each</span> : null}
        </span>
        {timeLabel ? <span class="dur">{timeLabel}</span> : null}
      </span>
    </button>
  ) : (
    <article class="svc">
      <span class="svc-top">
        <span class="ico" set:html={icon} />
      </span>
      <span class="svc-name">{name}</span>
      <span class="svc-line">{line}</span>
      <span class="svc-foot">
        <span>
          <span class="plabel">Starting labor</span>
          <span class="price">${service.labor}</span>
          {service.each ? <span class="each">${service.each} each</span> : null}
        </span>
        {timeLabel ? <span class="dur">{timeLabel}</span> : null}
      </span>
    </article>
  )
}
