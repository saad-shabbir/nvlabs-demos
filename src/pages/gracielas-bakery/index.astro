    height: 160px;
    margin: 1.1rem auto 0.85rem;
    object-fit: cover;
    border-radius: 50%;
  }

  .hero h1 {
    max-width: 16ch;
    margin: 0 auto;
    font-size: clamp(2.05rem, 8vw, 3.5rem);
    line-height: 1.08;
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .hero-line {
    margin: 0.85rem auto 0;
    max-width: 28rem;
    font-size: 1.08rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1.35rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.65rem 1.15rem;
    border-radius: 20px;
    border: 1.5px solid #f24b8d;
    font: inherit;
    font-size: 1rem;
    text-decoration: none;
    cursor: pointer;
    text-align: center;
  }

  .btn-fill {
    background: #c2185b;
    border-color: #c2185b;
    color: #fff;
  }

  .btn-line {
    background: #fff;
    color: #f24b8d;
  }

  .btn-white {
