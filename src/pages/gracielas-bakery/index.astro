        </div>
      </section>

      <section id="visit" class="band visit rise" aria-labelledby="visit-title">
        <div class="wrap visit-grid">
          <img class="visit-photo" src="/gracielas-bakery/counter-interior.jpg" alt="The counter" />
          <div>
            <p class="eyebrow">Visit</p>
            <h2 id="visit-title">112 S Carroll Ave</h2>
