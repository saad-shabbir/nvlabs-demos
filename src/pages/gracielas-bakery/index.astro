    height: 46px;
    object-fit: cover;
    border-radius: 50%;
  }

  .links {
    display: none;
  }

  .links a {
    text-decoration: none;
    color: #714741;
  }

  .call-pill,
  .menu-btn {
    font: inherit;
    border-radius: 999px;
    text-decoration: none;
  }

  .call-pill {
    margin-left: auto;
    background: #c2185b;
    color: #fff;
    padding: 0.42rem 0.85rem;
    font-size: 0.95rem;
  }

  .menu-btn {
    background: #fff;
    color: #714741;
    border: 1px solid rgba(242, 75, 141, 0.45);
    padding: 0.4rem 0.75rem;
    cursor: pointer;
  }

  .links.open {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: calc(100% - 0.2rem);
    left: 0.75rem;
    right: 0.75rem;
    padding: 0.35rem;
    background: #fff;
    border: 1px solid rgba(242, 75, 141, 0.2);
    border-radius: 20px;
    box-shadow: 0 12px 28px rgba(113, 71, 65, 0.08);
  }

  .links.open a {
    padding: 0.75rem 0.85rem;
    border-radius: 14px;
  }

  .hero {
    margin-top: -4.25rem;
    padding: 6.4rem 1.15rem 4.2rem;
    text-align: center;
    background: linear-gradient(180deg, #ffdde8 0%, #fff9f0 78%);
  }

  .loc-pill {
    display: inline-block;
    background: #fff;
    color: #f24b8d;
    border: 1px solid #f24b8d;
    border-radius: 999px;
    padding: 0.32rem 0.8rem;
    font-size: 0.88rem;
  }

