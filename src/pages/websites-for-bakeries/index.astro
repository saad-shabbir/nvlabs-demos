---
import Base from "../../layouts/Base.astro";
import MarketingChrome from "../../components/MarketingChrome.astro";

const phoneDisplay = "(501) 413-3386";
const tel = "tel:+15014133386";
const sms = "sms:+15014133386";
---

<Base
  title="Websites for bakeries | NV Labs"
  description="Free working website demos for bakeries and sweet shops. Call or text Saad Shabbir at (501) 413-3386."
  image="/og.png"
  robots="index, follow"
>
  <MarketingChrome>
    <section class="hero" aria-labelledby="hero-title">
      <p class="eyebrow">For bakeries and sweet shops</p>
      <h1 id="hero-title">A real website for your bakery, starting with a free demo.</h1>
      <p class="lede">
        If customers only find you on Instagram, or your site is outdated, I build a phone-friendly
        demo of your bakery and send you the link. You can tap call, maps, and menu pages just like
        a live site. If you like it, I help you put it on your own domain.
      </p>
      <div class="hero-cta">
        <a class="btn btn-accent btn-lg" href={tel}>Call {phoneDisplay}</a>
        <a class="btn btn-ghost btn-lg" href={sms}>Text me</a>
        <a class="btn btn-text" href="/#work">See bakery demos</a>
      </div>
    </section>

    <section class="section" aria-labelledby="why-title">
      <h2 id="why-title">Why bakeries need more than Instagram</h2>
      <p>
        Instagram is great for photos. A website is where people look up hours, grab directions,
        call you, and send friends a clean link. Search and maps also work better when you have a
        real page for your shop.
      </p>
      <ul>
        <li>Show cakes, pastries, and specialties without app clutter</li>
        <li>One tap to call or get directions from a phone</li>
        <li>A link you can put on Google Business, flyers, and packaging</li>
        <li>Looks like your shop, not a generic template</li>
      </ul>
    </section>

    <section class="section" aria-labelledby="how-title">
      <h2 id="how-title">How the free demo works</h2>
      <p>
        You do not need to write copy or pick a theme first. I put together a working demo from
        what you already post publicly, then send you the private link. No pressure to buy anything
        if it is not a fit.
      </p>
      <ul>
        <li>I build a free demo for your bakery</li>
        <li>You open it on your phone and try the buttons</li>
        <li>If you want it live, I help you take it to your domain</li>
      </ul>
    </section>

    <section class="section" aria-labelledby="cta-title">
      <h2 id="cta-title">Want a bakery demo?</h2>
      <p>Call or text Saad Shabbir. Tell me your shop name and city.</p>
      <a class="phone-big" href={tel}>{phoneDisplay}</a>
      <div class="hero-cta">
        <a class="btn btn-accent btn-lg" href={tel}>Call</a>
        <a class="btn btn-ghost btn-lg" href={sms}>Text</a>
      </div>
      <a class="back-home" href="/">Back to NV Labs home</a>
    </section>
  </MarketingChrome>
</Base>
