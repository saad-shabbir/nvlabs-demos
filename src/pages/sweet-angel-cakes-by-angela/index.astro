---
import Demo from "../../layouts/Demo.astro";

const smsBody = [
  "Hi, I would like to place an order.",
  "",
  "Name and phone:",
  "Date of interest:",
  "Pickup or delivery time:",
  "Delivery address if delivery:",
  "Custom cake or other bake:",
  "Theme colors and inspiration photos:",
  "Number of servings:",
  "Payment method (Zelle, Venmo, or CashApp):",
].join("\n");

const sms = `sms:+19154976661?body=${encodeURIComponent(smsBody)}`;
const tel = "tel:+19154976661";
const maps =
  "https://www.google.com/maps/search/?api=1&query=Bauxite+Ave+El+Paso+TX+79932";

const hours = [
  ["Monday", "9:00 AM–5:00 PM"],
  ["Tuesday", "10:00 AM–6:00 PM"],
  ["Wednesday", "10:00 AM–6:00 PM"],
  ["Thursday", "10:00 AM–6:00 PM"],
  ["Friday", "10:00 AM–4:00 PM"],
  ["Saturday", "10:00 AM–12:30 PM"],
  ["Sunday", "Closed"],
];
---


<Demo
  businessName="Sweet Angel Cakes by Angela"
  title="Sweet Angel Cakes by Angela"
  description="Cottage bakery in El Paso specializing in custom cakes, cupcakes, and other sweet bakes. Call or text to order."
  image="/sweet-angel-cakes-by-angela/hero.jpg"
>
  <div class="angel">
    <header class="bar">
      <a class="bar-brand" href="#top">
        <img
          class="bar-logo"
          src="/sweet-angel-cakes-by-angela/logo.png"
          alt=""
          width="800"
          height="798"
        />
        <span class="visually-hidden">Sweet Angel Cakes by Angela</span>
      </a>
      <nav class="bar-nav" aria-label="On this page">
        <a href="#menu">Menu</a>
        <a href="#cakes">Cakes</a>
        <a href="#order">Order</a>
        <a href="#hours">Hours</a>
        <a href="#reviews">Reviews</a>
      </nav>
      <div class="bar-actions">
        <a class="bar-phone" href={tel}>(915) 497-6661</a>
        <a class="btn ghost" href={tel}>Call</a>
        <a class="btn" href={sms}>Text to order</a>
      </div>
    </header>

    <section class="hero" id="top">
      <div class="hero-copy">
        <img
          class="logo"
          src="/sweet-angel-cakes-by-angela/logo.png"
          alt="Sweet Angel Cakes by Angela. Custom Cakes and Bakes."
          width="800"
          height="798"
        />
        <p class="eyebrow">Custom cakes and bakes</p>
        <h1>Sweet Angel Cakes <span>by Angela</span></h1>
        <p class="lede">
          Cottage bakery specializing in custom cakes, cupcakes and other sweet bakes
          for any occasion or just because.
        </p>
        <p class="biscochos">Best Biscochos de anise in town.</p>
        <p class="phone"><a href={tel}>(915) 497-6661</a></p>
        <div class="actions">
          <a class="btn" href={sms}>Text to order</a>
          <a class="btn ghost" href={tel}>Call</a>
        </div>
      </div>
      <div class="hero-photo">
        <img
          src="/sweet-angel-cakes-by-angela/hero.jpg"
          alt="Custom celebration cake with pink, blue, and purple layers"
          width="1200"
          height="1200"
        />
      </div>
    </section>

    <section class="menu-wrap" id="bakes">
      <div class="menu-inner">
        <h2>What I Bake</h2>
        <p class="note">
          Best Biscochos de anise in town. Signature cookies and more, made to order.
        </p>
        <ul class="menu">
          <li>
            <span class="item">Biscochitos de anise</span>
            <span class="price">$--</span><!-- Angela: add your price here -->
          </li>
          <li>
            <span class="item">Cocoa bombs</span>
            <span class="price">$--</span><!-- Angela: add your price here -->
          </li>
          <li>
            <span class="item">Banana bread</span>
            <span class="price">$--</span><!-- Angela: add your price here -->
          </li>
          <li>
            <span class="item">Custom cakes</span>
            <span class="price">Message for pricing</span>
          </li>
          <li>
            <span class="item">Cupcakes</span>
            <span class="price">Message for pricing</span>
          </li>
        </ul>
        <p class="actions tight">
          <a class="btn" href={sms}>Text to order</a>
        </p>
      </div>
    </section>

    <ul class="strip">
      <li>48 hour notice.</li>
      <li>Pickup at Bauxite Ave, El Paso, TX 79932.</li>
      <li><a href={tel}>(915) 497-6661</a></li>
    </ul>

    <section class="custom" id="cakes">
      <div class="custom-photo">
        <img
          src="/sweet-angel-cakes-by-angela/army-cake.jpg"
          alt="Three-tier custom celebration cake"
          width="1400"
          height="1400"
          loading="lazy"
        />
      </div>
      <div class="prose">
        <h2>Custom cakes</h2>
        <p>
          Texas cottage food producer specializing in all occasion cakes, cupcakes
          and other sweet bakes.
        </p>
        <p>Custom orders and large orders: message for pricing and availability.</p>
        <p class="actions tight">
          <a class="btn" href={sms}>Text to order</a>
        </p>
      </div>
    </section>

    <section class="menu-wrap" id="menu">
      <div class="menu-inner">
        <h2>Fall menu</h2>
        <p class="note">Message for available dates and items.</p>
        <div class="menu-grid">
          <div>
            <h3>Bread, large loaf</h3>
            <ul class="menu">
              <li><span class="item">Banana Bread</span><span class="price">$11</span></li>
              <li><span class="item">Cinnamon Swirl Bread</span><span class="price">$12</span></li>
              <li><span class="item">Pumpkin Bread</span><span class="price">$12</span></li>
            </ul>
            <p class="addins">Add-ins +$1 each: Nuts, Chocolate Chips.</p>
          </div>
          <div>
            <h3>Cinnamon Rolls, 1 dozen tray</h3>
            <ul class="menu">
              <li><span class="item">Classic</span><span class="price">$38</span></li>
              <li><span class="item">Apple</span><span class="price">$42</span></li>
              <li><span class="item">Pumpkin &amp; Spice</span><span class="price">$42</span></li>
            </ul>
          </div>
          <div>
            <h3>Fall-inspired cookies</h3>
            <ul class="menu">
              <li><span class="item">Biscocho Cookies</span><span class="price">$20 per 5 dozen</span></li>
              <li><span class="item">Polvorones</span><span class="price">$25 per 2½ dozen</span></li>
            </ul>
          </div>
        </div>
        <p class="signoff">Small batch baking. Made with love.</p>
      </div>
    </section>

    <section class="reviews" id="reviews">
      <div class="reviews-inner">
        <h2>Reviews</h2>
        <div class="quotes">
          <figure>
            <blockquote>
              <p>
                Angela’s cocoa bombs were so beautiful and tasted just as delicious
                also bought some banana bread and soooo good! Her pastries and
                decorations are so wonderful!
              </p>
            </blockquote>
            <figcaption>Sarah Vai, January 29, 2021</figcaption>
          </figure>
          <figure>
            <blockquote>
              <p>
                One of the best birthday cakes I’ve ever had! Both tasting and
                beautiful to look at.
              </p>
            </blockquote>
            <figcaption>Laura Mendoza, July 1, 2019</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="order" id="order">
      <div class="order-inner">
        <div>
          <h2>How to order</h2>
          <ul class="facts">
            <li>48 hour notice.</li>
            <li>50% non-refundable deposit, Zelle or CashApp.</li>
            <li>Pickup at Bauxite Ave, El Paso, TX 79932.</li>
            <li>Call or text to order. You can also message on Instagram or Facebook.</li>
          </ul>
          <p class="zelle">There is a discount for using Zelle.</p>
          <div class="actions">
            <a class="btn" href={sms}>Text these details</a>
            <a class="btn ghost" href={tel}>Call</a>
          </div>
        </div>
        <div>
          <h3>For a quote, send</h3>
          <ol>
            <li>Name and phone</li>
            <li>Date of interest</li>
            <li>Pickup or delivery time, and delivery address if delivery (fee applies)</li>
            <li>Custom cake or other bake</li>
            <li>Theme colors and inspiration photos</li>
            <li>Number of servings</li>
            <li>Payment method: Zelle, Venmo, or CashApp</li>
          </ol>
        </div>
      </div>
    </section>

    <footer id="visit">
      <div class="foot">
        <div>
          <p class="brand">Sweet Angel Cakes by Angela</p>
          <p class="certs">
            Food Safe Certified. State registered to sell refrigerated homemade
            desserts. DSHS Registered. Texas Homemade verified.
          </p>
        </div>
        <div id="hours">
          <h2>Hours</h2>
          <dl>
            {
              hours.map(([day, time]) => (
                <>
                  <dt>{day}</dt>
                  <dd>{time}</dd>
                </>
              ))
            }
          </dl>
        </div>
        <div>
          <h2>Pickup</h2>
          <p class="place">Bauxite Ave, El Paso, TX 79932.</p>
          <p class="dir"><a class="btn ghost" href={maps}>Directions</a></p>
          <p class="links">
            <a href="https://www.instagram.com/sweetangelcakesbyangela/">Instagram</a>
            <a href="https://www.facebook.com/sweetangelcakesbyangela">Facebook</a>
            <a href="mailto:sweetangelcakesbyangela@yahoo.com">Email</a>
            <a href={tel}>(915) 497-6661</a>
          </p>
        </div>
      </div>
    </footer>

    <nav class="dock" aria-label="Order">
      <a href={tel}>Call</a>
      <a href={sms}>Text</a>
    </nav>
  </div>
</Demo>

<style>
  :global(html),
  :global(body) {
    background: #feebe5;
  }

  .angel {
    --ink: #1b1214;
    --cream: #feebe5;
    --paper: #fff8f4;
    --blush: #fdb1b1;
    --rose: #b85a68;
    --muted: #5c4548;
    --line: rgba(27, 18, 20, 0.22);
    background: var(--cream);
    color: var(--ink);
    font-family: "Avenir Next", "Segoe UI", ui-sans-serif, system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.5;
    padding-bottom: calc(4.75rem + env(safe-area-inset-bottom));
  }

  .angel * {
    min-width: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  h1,
  h2,
  h3,
  .biscochos,
  .place,
  .brand,
  .item,
  .zelle,
  blockquote p {
    font-family: "Iowan Old Style", Palatino, "Palatino Linotype", Georgia, serif;
  }

  h1 {
    margin: 0 0 0.85rem;
    font-size: clamp(3.15rem, 12vw, 4.4rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.88;
  }

  h1 span {
    display: block;
    margin-top: 0.28rem;
    color: var(--rose);
    font-style: italic;
    font-size: 0.58em;
    letter-spacing: -0.03em;
  }

  h2 {
    margin: 0 0 0.85rem;
    font-size: clamp(2.5rem, 6vw, 4.4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.94;
  }

  h3 {
    margin: 0 0 0.45rem;
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  p {
    margin: 0 0 0.85rem;
  }

  a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--ink);
    color: var(--cream);
    font: inherit;
    font-size: 0.98rem;
    font-weight: 650;
    line-height: 1.1;
    text-align: center;
    text-decoration: none;
  }

  .btn.ghost {
    background: transparent;
    color: var(--ink);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    position: sticky;
    top: 0;
    z-index: 6;
    background: #feebe5;
    border-bottom: 1px solid rgba(27, 18, 20, 0.1);
    padding: 0.35rem 0.85rem;
  }

  .bar-logo {
    display: block;
    width: 3.35rem;
    height: auto;
  }

  .bar-nav,
  .bar-phone,
  .bar .ghost {
    display: none;
  }

  .bar-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .bar .btn {
    min-height: 44px;
    padding-inline: 1rem;
  }

  .hero {
    display: flex;
    flex-direction: column;
  }

  .hero-photo {
    order: -1;
  }

  .hero-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-copy {
    padding: 0.85rem 1.15rem 1.15rem;
    text-align: center;
  }

  .logo {
    display: block;
    width: min(7.25rem, 38vw);
    height: auto;
    margin: 0 auto 0.2rem;
  }

  .eyebrow {
    margin: 0 0 0.45rem;
    color: var(--rose);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .lede {
    margin-inline: auto;
    max-width: 36rem;
    font-size: 1.05rem;
  }

  .biscochos {
    margin: 0.1rem auto 0.35rem;
    max-width: 22rem;
    font-size: clamp(1.35rem, 4vw, 1.7rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.2;
  }

  .phone {
    margin: 0 0 0.85rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .phone a,
  .bar-phone,
  .strip a {
    color: inherit;
    text-decoration: none;
  }

  .phone a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 0.4rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }

  .actions .btn {
    flex: 1 1 9.5rem;
    max-width: 16rem;
  }

  .actions.tight {
    justify-content: flex-start;
    margin: 0.4rem 0 0;
  }

  .actions.tight .btn {
    flex: 0 1 auto;
  }

  .strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.15rem 1.35rem;
    margin: 0;
    padding: 0.35rem 1rem;
    list-style: none;
    background: var(--blush);
    text-align: center;
  }

  .strip li {
    padding: 0.45rem 0.4rem;
    font-weight: 650;
  }

  .strip a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
  }

  .custom-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .prose {
    padding: 2rem 1.15rem 2.3rem;
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .menu-wrap {
    padding: 2.5rem 1.15rem 2.6rem;
    background: var(--paper);
  }

  .note,
  .addins {
    color: var(--muted);
  }

  .note {
    margin: -0.2rem 0 1.5rem;
    font-size: 1.05rem;
  }

  .menu-grid {
    display: grid;
    gap: 1.75rem;
  }

  .menu {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.72rem 0;
    border-bottom: 1px dotted var(--line);
  }

  .item {
    font-size: 1.22rem;
    line-height: 1.25;
  }

  .price {
    font-variant-numeric: tabular-nums;
    font-weight: 650;
    white-space: nowrap;
  }

  .addins {
    margin: 0.75rem 0 0;
    font-size: 0.98rem;
  }

  .signoff {
    margin: 2rem 0 0.15rem;
    font-family: "Iowan Old Style", Palatino, Georgia, serif;
    font-style: italic;
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
    line-height: 1.25;
  }

  .reviews {
    padding: 2.6rem 1.15rem 2.7rem;
  }

  .quotes {
    display: grid;
    gap: 0.9rem;
  }

  figure {
    margin: 0;
    padding: 1.2rem 1.15rem 1.1rem;
    background: var(--paper);
    border-radius: 1.25rem;
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    margin: 0;
    font-size: clamp(1.2rem, 2.4vw, 1.45rem);
    font-weight: 500;
    line-height: 1.35;
  }

  figcaption {
    margin-top: 0.9rem;
    color: var(--rose);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .order {
    background: var(--blush);
    padding: 2.5rem 1.15rem 2.6rem;
  }

  .order-inner {
    display: grid;
    gap: 1.8rem;
  }

  .facts {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }

  .facts li {
    padding: 0.68rem 0;
    border-top: 1px solid rgba(27, 18, 20, 0.18);
  }

  .facts li:last-child {
    border-bottom: 1px solid rgba(27, 18, 20, 0.18);
  }

  .zelle {
    font-size: 1.35rem;
    font-style: italic;
    line-height: 1.3;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: quote;
  }

  ol li {
    counter-increment: quote;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.58rem 0;
    border-bottom: 1px dotted rgba(27, 18, 20, 0.35);
  }

  ol li::before {
    content: counter(quote, decimal-leading-zero);
    font-family: "Iowan Old Style", Palatino, Georgia, serif;
  }

  footer {
    background: var(--ink);
    color: var(--cream);
    padding: 2.3rem 1.15rem 2.1rem;
  }

  footer h2 {
    color: var(--cream);
    font-size: 1.7rem;
    margin-bottom: 0.7rem;
  }

  .brand {
    margin: 0 0 0.55rem;
    font-size: clamp(1.8rem, 4vw, 2.3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .certs,
  .place {
    color: rgba(254, 235, 229, 0.82);
  }

  .place {
    margin: 0 0 0.85rem;
    font-size: 1.35rem;
    line-height: 1.25;
    max-width: 18ch;
  }

  .dir {
    margin: 0 0 0.4rem;
  }

  footer .btn.ghost {
    color: var(--cream);
    border-color: rgba(254, 235, 229, 0.7);
  }

  dl {
    display: grid;
    grid-template-columns: 1fr auto;
    margin: 0 0 0.4rem;
  }

  dt,
  dd {
    margin: 0;
    padding: 0.38rem 0;
    border-bottom: 1px dotted rgba(254, 235, 229, 0.28);
  }

  dt {
    padding-right: 1rem;
    font-weight: 650;
  }

  dd {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  dd:last-of-type {
    font-family: "Iowan Old Style", Palatino, Georgia, serif;
    font-style: italic;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.25rem;
    margin: 0.35rem 0 0;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.3rem 0.15rem;
    margin-right: 0.85rem;
    color: inherit;
    font-weight: 650;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  footer a:focus-visible,
  .dock a:focus-visible {
    outline-color: var(--cream);
  }

  .dock {
    position: fixed;
    z-index: 8;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--ink);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .dock a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    color: var(--cream);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.92rem;
  }

  .dock a + a {
    box-shadow: inset 1px 0 0 rgba(254, 235, 229, 0.28);
  }

  #menu,
  #order,
  #hours,
  #reviews,
  #cakes,
  #top {
    scroll-margin-top: 5.25rem;
  }

  @media (min-width: 800px) {
    .angel {
      padding-bottom: 0;
    }

    .bar {
      padding-inline: 1.25rem;
    }

    .bar-logo {
      width: 4.15rem;
    }

    .bar-phone,
    .bar .ghost {
      display: inline-flex;
    }

    .bar-phone {
      align-items: center;
      min-height: 44px;
      padding: 0 0.35rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .dock {
      display: none;
    }

    .hero-copy {
      padding: 2.5rem 2rem 2.2rem;
    }

    .logo {
      width: 11rem;
    }

    .menu-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 2.75rem;
    }

    .strip {
      flex-wrap: nowrap;
      padding: 0.15rem 1.5rem;
    }

    .foot {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 2rem 2.5rem;
    }
  }

  @media (min-width: 1100px) {
    .bar-nav {
      display: flex;
      align-items: center;
      gap: 0.1rem;
      margin-left: 0.35rem;
    }

    .bar-nav a,
    .links a:hover,
    .bar-phone:hover,
