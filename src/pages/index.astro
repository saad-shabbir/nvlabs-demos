---
import Base from "../layouts/Base.astro";

const phoneDisplay = "(501) 413-3386";
const tel = "tel:+15014133386";
const sms = "sms:+15014133386";

const demos = [
  {
    name: "Sweet Angel Cakes by Angela",
    blurb: "Custom cakes and bakery",
    href: "/sweet-angel-cakes-by-angela/",
    thumb: "/sweet-angel-cakes-by-angela/hero.jpg",
    thumbAlt: "Decorated cake from Sweet Angel Cakes by Angela",
  },
  {
    name: "High Sweet Creamery",
    blurb: "Soft-serve creamery",
    href: "/high-sweet/",
    thumb: "/high-sweet/swirl.jpg",
    thumbAlt: "Soft-serve swirl cone from High Sweet Creamery",
  },
  {
    name: "Graciela's Bakery",
    blurb: "Mexican bakery",
    href: "/gracielas-bakery/",
    thumb: "/gracielas-bakery/colorful-conchas-tray.jpg",
    thumbAlt: "Tray of colorful conchas from Graciela's Bakery",
  },
  {
    name: "Aaron the Mechanic",
    blurb: "Houston mobile mechanic",
    href: "/aaron-the-mechanic/",
    thumb: "/aaron-the-mechanic/porsche-oil-service.jpg",
    thumbAlt: "Porsche oil service by Aaron the Mechanic",
  },
];
---

<Base
  title="Websites for local businesses | NV Labs"
  description="Free working demo websites for local shops, then help going live. Call or text Saad Shabbir at (501) 413-3386."
  image="/og.png"
  robots="index, follow"
>
  <div class="mkt">
    <header class="top">
      <a class="brand" href="/">
        <span class="brand-mark">NV Labs</span>
        <span class="brand-sub">Saad Shabbir</span>
      </a>
      <div class="top-actions">
        <a class="btn btn-ghost" href={tel}>Call</a>
        <a class="btn btn-accent" href={sms}>Text</a>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <p class="eyebrow">Free demos for local shops</p>
        <h1 id="hero-title">I build you a working website demo. Then we can put it live.</h1>
        <p class="lede">
          Weak site, missing site, or Instagram only? I put together a real phone-friendly
          demo of your business and send you the link. If you like it, I help you take it live.
        </p>
        <div class="hero-cta">
          <a class="btn btn-accent btn-lg" href={tel}>Call {phoneDisplay}</a>
          <a class="btn btn-ghost btn-lg" href={sms}>Text me</a>
          <a class="btn btn-ghost btn-lg" href="#work">See the work</a>
        </div>
      </section>

      <section class="section steps" aria-labelledby="steps-title">
        <h2 id="steps-title">How it works</h2>
        <ol class="step-list">
          <li>
            <span class="step-num">1</span>
            <div>
              <h3>I build a free demo</h3>
              <p>I find a business with a weak or missing site, or you send me one. I build a working demo at a private link.</p>
            </div>
          </li>
          <li>
            <span class="step-num">2</span>
            <div>
              <h3>You open it on your phone</h3>
              <p>I send you the link. You tap call, maps, and the rest just like a real site.</p>
            </div>
          </li>
          <li>
            <span class="step-num">3</span>
            <div>
              <h3>We put it live if you want</h3>
              <p>Like it? I help you take it live on your own domain. No pressure if you pass.</p>
            </div>
          </li>
        </ol>
      </section>

      <section class="section work" id="work" aria-labelledby="work-title">
        <div class="section-head">
          <h2 id="work-title">Live demos</h2>
          <p>Real demos I built for local businesses. Open any one on your phone.</p>
        </div>
        <ul class="cards">
          {
            demos.map((d) => (
              <li>
                <a class="card" href={d.href}>
                  <div class="card-media">
                    <img src={d.thumb} alt={d.thumbAlt} width="640" height="400" loading="lazy" />
                    <span class="demo-tag">Demo</span>
                  </div>
                  <div class="card-body">
                    <h3>{d.name}</h3>
                    <p>{d.blurb}</p>
                    <span class="card-link">View demo</span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section for" aria-labelledby="for-title">
        <h2 id="for-title">Who it's for</h2>
        <ul class="for-list">
          <li>Bakeries and sweet shops</li>
          <li>Retail shops and storefronts</li>
          <li>Mobile services (mechanics, cleaners, trades)</li>
          <li>Anyone still using only Instagram for the business</li>
        </ul>
      </section>

      <section class="section contact" id="contact" aria-labelledby="contact-title">
        <h2 id="contact-title">Want a demo for your shop?</h2>
        <p class="contact-lede">Call or text. Or leave a note below and I'll reach out.</p>
        <a class="phone-big" href={tel}>{phoneDisplay}</a>
        <div class="hero-cta contact-cta">
          <a class="btn btn-accent btn-lg" href={tel}>Call</a>
          <a class="btn btn-ghost btn-lg" href={sms}>Text</a>
        </div>

        <form class="form" id="contact-form" novalidate>
          <label>
            <span>Name</span>
            <input type="text" name="name" autocomplete="name" />
          </label>
          <label>
            <span>Business</span>
            <input type="text" name="business" autocomplete="organization" />
          </label>
          <label>
            <span>Phone</span>
            <input type="tel" name="phone" autocomplete="tel" />
          </label>
          <label>
            <span>City</span>
            <input type="text" name="city" autocomplete="address-level2" />
          </label>
          <label class="full">
            <span>Notes</span>
            <textarea name="notes" rows="4"></textarea>
          </label>
          <button class="btn btn-accent btn-lg full" type="submit">Send note</button>
          <p class="form-msg" id="form-msg" hidden tabindex="-1">
            This message stays on the page for now. Call or text {phoneDisplay}.
          </p>
        </form>
      </section>
    </main>

    <footer class="foot">
      <p><strong>NV Labs</strong> · Saad Shabbir</p>
      <p>
        <a href={tel}>{phoneDisplay}</a>
      </p>
      <p class="foot-note">
        Demos live under this same host for now at demo.nvlabs.co. When ready, nvlabs.co can point here too.
      </p>
    </footer>
  </div>

  <script>
    const form = document.getElementById("contact-form");
    const msg = document.getElementById("form-msg");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (msg) {
        msg.hidden = false;
        msg.focus?.();
      }
    });
  </script>
</Base>

<style>
  .mkt {
    --bg: #0f0e0c;
    --surface: #171512;
    --line: #2a2620;
    --ink: #f5f0e6;
    --muted: #b7aea0;
    --accent: #e8c56a;
    --accent-ink: #1a1508;
    --cream: #f3ebda;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial,
      sans-serif;
  }

  .mkt a {
    color: inherit;
    text-decoration: none;
  }

  .top {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    background: rgba(15, 14, 12, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    min-width: 0;
  }

  .brand-mark {
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 1rem;
  }

  .brand-sub {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .top-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border-radius: 999px;
    border: 1px solid transparent;
    padding: 0.55rem 0.95rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
  }

  .btn-lg {
    padding: 0.8rem 1.2rem;
    font-size: 1rem;
  }

  .mkt .btn-accent {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .mkt .btn-ghost {
    background: transparent;
    border-color: var(--line);
    color: var(--ink);
  }

  .btn-text {
    background: transparent;
    color: var(--cream);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    font-weight: 500;
    padding-left: 0.25rem;
    padding-right: 0.25rem;
  }

  .hero,
  .section,
  .foot {
    width: min(72rem, calc(100% - 2rem));
    margin-inline: auto;
  }

  .hero {
    padding: 2.4rem 0 2rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2rem, 7vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 700;
  }

  .lede {
    margin: 1rem 0 0;
    max-width: 34rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.4rem;
  }

  .section {
    padding: 2.25rem 0;
    border-top: 1px solid var(--line);
  }

  .section h2,
  .section-head h2 {
    margin: 0;
    font-size: clamp(1.45rem, 4vw, 2rem);
    letter-spacing: -0.03em;
  }

  .section-head p {
    margin: 0.55rem 0 0;
    color: var(--muted);
    max-width: 36rem;
  }

  .step-list {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .step-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    padding: 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1rem;
  }

  .step-num {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .step-list h3 {
    margin: 0.1rem 0 0.35rem;
    font-size: 1.05rem;
  }

  .step-list p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .cards {
    list-style: none;
    margin: 1.35rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .card {
    display: block;
    overflow: hidden;
    border-radius: 1.1rem;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .card:hover,
  .card:focus-visible {
    border-color: #4a4338;
    transform: translateY(-1px);
  }

  .card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #0a0908;
    overflow: hidden;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .demo-tag {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    background: rgba(15, 14, 12, 0.82);
    border: 1px solid rgba(232, 197, 106, 0.35);
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card-body {
    padding: 1rem 1rem 1.15rem;
  }

  .card-body h3 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .card-body p {
    margin: 0.35rem 0 0.7rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .card-link {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.92rem;
  }

  .for-list {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .for-list li {
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background: var(--surface);
  }

  .contact {
    text-align: left;
  }

  .contact-lede {
    margin: 0.6rem 0 0;
    color: var(--muted);
  }

  .phone-big {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--cream);
  }

  .contact-cta {
    margin-top: 1rem;
  }

  .form {
    margin-top: 1.5rem;
    display: grid;
    gap: 0.8rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 1.1rem;
    background: var(--surface);
  }

  .form label {
    display: grid;
    gap: 0.35rem;
  }

  .form label span {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .form input,
  .form textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: #0f0e0c;
    color: var(--ink);
    padding: 0.75rem 0.85rem;
    font: inherit;
  }

  .form input:focus,
  .form textarea:focus {
    outline: 2px solid rgba(232, 197, 106, 0.55);
    outline-offset: 1px;
  }

  .form .full {
    grid-column: 1 / -1;
  }

  .form-msg {
    margin: 0;
    grid-column: 1 / -1;
    padding: 0.85rem 0.95rem;
    border-radius: 0.75rem;
    background: rgba(232, 197, 106, 0.12);
    border: 1px solid rgba(232, 197, 106, 0.35);
    color: var(--cream);
  }

  .foot {
    padding: 2rem 0 2.5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem;
  }

  .foot p {
    margin: 0 0 0.45rem;
  }

  .foot strong {
    color: var(--ink);
  }

  .foot a {
    color: var(--cream);
  }

  .foot-note {
    max-width: 36rem;
    margin-top: 0.75rem !important;
    font-size: 0.85rem;
  }

  @media (min-width: 640px) {
    .top {
      padding-inline: 1.25rem;
    }

    .step-list {
      grid-template-columns: repeat(3, 1fr);
    }

    .step-list li {
      grid-template-columns: 1fr;
      min-height: 100%;
    }

    .cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .form {
      grid-template-columns: 1fr 1fr;
      padding: 1.2rem;
    }
  }

  @media (min-width: 960px) {
    .hero {
      padding-top: 3.4rem;
      padding-bottom: 2.6rem;
    }

    .cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
